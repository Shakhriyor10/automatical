TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_TOKEN_HERE

# Optional. Leave empty while testing, or put your Telegram numeric user id.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=

# Telegram bot will scan Wi-Fi in the background every 10 seconds.
TELEGRAM_SCAN_INTERVAL_SECONDS=10

# Group alerts for employees who did not arrive on time.
# Group/supergroup ids in Telegram are often negative, for example -1001234567890.
TELEGRAM_LATE_ALERT_CHAT_ID=5262110076
TELEGRAM_LATE_ALERT_START_TIME=
TELEGRAM_LATE_ALERT_CHECK_INTERVAL_SECONDS=30

# Daily employee arrival list. Empty chat id uses TELEGRAM_LATE_ALERT_CHAT_ID.
TELEGRAM_DAILY_REPORT_CHAT_ID=
TELEGRAM_DAILY_REPORT_TIME=09:00
TELEGRAM_DAILY_REPORT_CHECK_INTERVAL_SECONDS=10
